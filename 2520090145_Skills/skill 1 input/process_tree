#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

static void print_identity(const char *label) {
    printf("%-10s PID = %d | PPID = %d\n", label, getpid(), getppid());
    fflush(stdout);
}

int main(void) {
    print_identity("[ROOT]");

    pid_t child1 = fork();

    if (child1 == 0) {
        print_identity("[CHILD-1]");

        pid_t grandchild = fork();
        if (grandchild == 0) {
            print_identity("[GRANDCHILD]");
            sleep(3);
            exit(0);
        } else {
            waitpid(grandchild, NULL, 0);
        }
        exit(0);
    }

    pid_t child2 = fork();
    if (child2 == 0) {
        print_identity("[CHILD-2]");
        sleep(2);
        exit(0);
    }

    waitpid(child1, NULL, 0);
    waitpid(child2, NULL, 0);

    printf("[ROOT]     All children reaped. Tree complete.\n");
    return 0;
}
