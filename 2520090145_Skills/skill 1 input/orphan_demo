#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main(void) {
    pid_t pid = fork();

    if (pid == 0) {
        sleep(2);
        printf("[CHILD] PID = %d, new PPID after orphaning = %d\n",
               getpid(), getppid());
    } else {
        printf("[PARENT] PID = %d exiting now, child PID = %d will be orphaned.\n",
               getpid(), pid);
        exit(0);
    }

    return 0;
}
